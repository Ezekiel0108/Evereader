#include <Arduino.h>
#include <FS.h>
#include <SD.h>
#include <SPI.h>

#define SD_SCK  12
#define SD_MISO 13
#define SD_MOSI 11
#define SD_CS   6

// Isolated custom SPI bus to prevent default pin collisions
SPIClass customSpi = SPIClass(FSPI);

void setup() {
  Serial.begin(115200);
  for(int i = 3; i > 0; i--) { delay(1000); }
  
  Serial.println("\n--- Passive Breakout Diagnostic ---");

  // Redundant software pull-up
  pinMode(SD_MISO, INPUT_PULLUP);

  Serial.println("Booting SPI bus...");
  customSpi.begin(SD_SCK, SD_MISO, SD_MOSI, SD_CS);

  Serial.println("Pinging 32GB card at 1MHz...");
  
  // Pass the lowercase customSpi object!
 if(!SD.begin(SD_CS, customSpi, 1000000)) {
    uint8_t cardType = SD.cardType();
    if(cardType == CARD_NONE) {
        Serial.println("[ERROR]: No card detected at all — check CS/wiring.");
    } else {
        Serial.println("[ERROR]: Card found but filesystem unreadable — reformat as FAT32.");
    }
    return;
} 
  Serial.println("[SUCCESS]: Card Mounted!");
  Serial.printf("Size: %llu MB\n", SD.cardSize() / (1024 * 1024));
}

void loop() {
  // Silent loop
}
